#include "../philo.h"

int	active_sleep(t_life_state *life, long unsigned int time)
{
	struct timeval	start;

	gettimeofday(&start, NULL);
	while ((interval(start) < time) && get_life(life))
	{
		if (usleep(1000) != 0)
			return (-1);
	}
	return (0);
}
