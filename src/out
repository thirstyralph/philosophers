#include "../philo.h"

int	active_sleep(int *life, uint32_t time)
{
	struct timeval	start;

	gettimeofday(&start, NULL);
	while (interval(start) < time && life)
	{
		if (usleep(10) != 0)
			return (-1);
	}
	return (0);
}
