#include "../philo.h"

int	active_sleep(uint32_t time, t_app *app)
{
	struct timeval	start;

	gettimeofday(&start, NULL);
	while ((interval(start) < time) && get_life(app))
	{
		if (usleep(1000) != 0)
			return (-1);
	}
	return (0);
}
