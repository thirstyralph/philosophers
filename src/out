#include "../philo.h"

int	hunger(t_app app, struct timeval last_meal)
{
	if (interval(last_meal) >= app.conf.ttd)
	{
		printf("illo que hambre tengo\n");
		return (1);
	}
	return (0);
}

pthread_t	spawn_monitor(t_philo **philos)
{
	pthread_t	monitor;

	pthread_create(&monitor, NULL, monitor_routine, philos);
	return (monitor);
}
