#include "../philo.h"

t_fork	*spawn_forks(uint32_t n)
{
	uint32_t		i;
	t_fork			*r;

	r = malloc(sizeof(pthread_mutex_t) * n);
	if (!r)
		return (NULL);
	i = 0;
	while (i < n)
	{
		r[i].ready = 1;
		if (pthread_mutex_init(&r[i].fork, NULL) != 0)
		{
			free(r);
			return (NULL);
		}
		i++;
	}
	return (r);
}
