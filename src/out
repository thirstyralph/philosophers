#include "../philo.h"

t_app	unify(t_conf *conf, pthread_mutex_t *forks)
{
	t_app			app;

	app.conf = *conf;
	app.forks = forks;
	pthread_mutex_init(&app.print, NULL);
	gettimeofday(&app.start, NULL);
	return (app);
}
