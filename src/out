#include "../philo.h"

pthread_mutex_t	*spawn_forks(uint32_t n)
{
	uint32_t		i;
	pthread_mutex_t	*r;

	r = malloc(sizeof(pthread_mutex_t) * n);
	if (!r)
		return (NULL);
	i = 0;
	while (i < n)
	{
		printf("mutex[%i] !=0\n", i);
		if (pthread_mutex_init(&r[i], NULL) != 0)
		{
			free(r);
			return (NULL);
		}
		i++;
	}
	return (r);
}
